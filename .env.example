# Copiá a `.env` y completá los valores.
# cp .env.example .env

# HTTP scan ingestion (API GW POST /scan)
TA_SCAN_URL=https://REPLACE.execute-api.eu-central-1.amazonaws.com/scan
TA_SCAN_SECRET=

# Tenant / cuenta de prueba (producers locales)
TA_TENANT_ID=tenant-demo
TA_AWS_ACCOUNT_ID=123456789012
TA_MCP_ENDPOINT_REF=mcp://demo/aws

# Opcional — Bedrock (dossier IA)
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
